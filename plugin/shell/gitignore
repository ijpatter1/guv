# guv-harness-gitignore — marker: the /guv:scaffold deploy appends its block only when this line is absent

# ─────────────────────────────────────────────
# guv harness core — the entries every harness-governed project needs.
# /guv:scaffold appends exactly this block (markers included) to a
# pre-existing .gitignore; keep it self-contained and stack-agnostic.
# ─────────────────────────────────────────────
# guv-core-start
# Environment & secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*-service-account.json
*-credentials.json
# Claude Code: personal overrides, not committed
.claude/settings.local.json
# Auto-generated agent memory — the evaluator / reviewer write this
# on the first /eval or /handoff (/guv:-namespaced under the plugin).
# Ignored by default so it doesn't sit untracked in every consumer project.
# A team that wants shared agent memory can force-add it
# (git add -f .claude/agent-memory/) and remove this line.
.claude/agent-memory/
# OS files
.DS_Store
Thumbs.db
# Docker sandbox (opt-in tier)
sandbox/*.log
sandbox/tmp/
# guv lane worktrees (guv-lane.sh — fan-out dispatch)
.worktrees/
# guv lane failure reports + collected lane outputs (lane-dispatch.sh — scratch)
.lane-reports/
# guv-core-end

# ─────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────
node_modules/
.pnp.*
.yarn/

# ─────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────
.next/
out/
dist/
build/
*.tsbuildinfo

# ─────────────────────────────────────────────
# Testing
# ─────────────────────────────────────────────
coverage/
test-results/
playwright-report/
blob-report/

# ─────────────────────────────────────────────
# IDE & editors
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ─────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
*.bak
*.tmp
*.temp
