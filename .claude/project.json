{
  "$schema": "./project.schema.json",
  "name": "claude-code-sandbox",
  "language": "shell",
  "packageManager": null,
  "roots": {
    "control": ".",
    "code": "."
  },
  "commands": {
    "test": "fail=0; for t in .claude/tests/*.test.sh; do err=$(mktemp); bash \"$t\" 2>\"$err\" || fail=1; [ -s \"$err\" ] && { echo \"[stderr] $(basename \"$t\")\"; cat \"$err\"; fail=1; }; rm -f \"$err\"; done; exit $fail",
    "build": null,
    "lint": null,
    "format": null,
    "dev": null,
    "install": null
  },
  "scaffoldCheck": "test -d .claude",
  "readyCheck": null,
  "formatExtensions": [
    "md",
    "json",
    "sh",
    "yml",
    "yaml"
  ],
  "guards": [],
  "ceremony": "task",
  "lanes": {
    "protectedProse": [
      "(^|/)(CHANGELOG|README)(\\.template)?\\.md$",
      "(^|/)plugin/"
    ]
  }
}
