{
  "$schema": "./project.schema.json",
  "name": "claude-code-sandbox",
  "language": "node",
  "packageManager": "npm",
  "roots": {
    "control": ".",
    "code": "."
  },
  "commands": {
    "test": "npm test",
    "build": "npm run build",
    "lint": "npm run lint",
    "format": "npx prettier --write",
    "dev": "npm run dev",
    "install": "npm install"
  },
  "scaffoldCheck": "test -f package.json",
  "readyCheck": "test -d node_modules",
  "formatExtensions": [
    "js",
    "jsx",
    "ts",
    "tsx",
    "json",
    "css",
    "scss",
    "md",
    "html",
    "yml",
    "yaml"
  ],
  "guards": ["npm-publish"],
  "ceremony": "phased"
}
